    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.41.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "shadcn": "^4.21.0",
