# Базовый URL API. Доступен в коде как import.meta.env.VITE_API_URL
# Только переменные с префиксом VITE_ попадают в клиентский бандл.
#
# Полный путь до мок-бэкенда. Бэкенд разрешает CORS для http://localhost:5173,
# поэтому фронт обращается к нему напрямую (без прокси Vite).
VITE_API_URL=http://localhost:3000/api/v1
